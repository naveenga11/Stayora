          <a class="nav-link nav-pill" href="/signup">Sign Up</a>
          <a class="btn btn-primary-custom" href="/login">Log In</a>
        <% } else { %>
          <a class="nav-link nav-pill" href="/listings/new">
            <i class="fa-solid fa-plus me-1"></i>Add Listing
