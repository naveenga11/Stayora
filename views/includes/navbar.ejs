<nav class="navbar navbar-expand-md stayora-navbar sticky-top">
  <div class="container-fluid px-4">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/listings">
      <div class="brand-icon">
        <i class="fa-solid fa-location-dot"></i>
      </div>
      <div class="brand-text">
        <span class="brand-name">Stayora</span>
        <span class="brand-tagline">Stay Somewhere Special</span>
      </div>
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation"
      style="color:var(--text-primary);">
      <i class="fa-solid fa-bars"></i>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">

      <!-- Navbar Search — functional, posts to /listings?q=... -->
      <form class="d-flex mx-auto my-2 my-md-0 search-form" role="search"
            action="/listings" method="GET">
        <div class="search-wrapper">
          <i class="fa-solid fa-magnifying-glass search-icon"></i>
          <input
            class="form-control search-input"
            type="search"
            name="q"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            placeholder="Search destinations, cities, countries…"
            aria-label="Search listings"
            autocomplete="off">
          <button class="btn btn-search" type="submit" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass me-1"></i>Search
          </button>
        </div>
      </form>

