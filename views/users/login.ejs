<% layout("/layouts/boilerplate") %>

<div class="form-page">
  <div class="text-center mb-3">
    <div style="width:3rem;height:3rem;background:var(--brand);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
      <i class="fa-solid fa-location-dot" style="color:#fff;font-size:1.2rem;"></i>
    </div>
    <h1>Welcome back</h1>
    <p class="form-subtitle">Log in to continue your journey with Stayora.</p>
  </div>

  <form action="/login" method="post" novalidate class="needs-validation">

    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input name="username" id="username" type="text" class="form-control" placeholder="Enter your username" required />
      <div class="invalid-feedback">Username is required.</div>
    </div>

    <div class="mb-3">
      <label for="password" class="form-label">Password</label>
      <input name="password" id="password" type="password" class="form-control" placeholder="Enter your password" required />
      <div class="invalid-feedback">Password is required.</div>
    </div>

    <button type="submit" class="btn-form-submit">
      <i class="fa-solid fa-right-to-bracket me-2"></i>Log In
    </button>
  </form>

  <p class="alt-link">
    Don't have an account? <a href="/signup">Sign up</a>
  </p>
</div>
