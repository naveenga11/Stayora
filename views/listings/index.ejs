<% layout("/layouts/boilerplate") %>

<!-- Filter Bar (sticky below navbar) -->
<div class="filters-section">
  <div class="container">
    <div id="filters">

      <a href="/listings" class="filter <%= !activeCategory ? 'active' : '' %>" title="All listings">
        <i class="fa-solid fa-border-all"></i>
        <p>All</p>
      </a>
      <a href="/listings?category=Trending<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>" title="Trending">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
      </a>
      <a href="/listings?category=Rooms<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Rooms' ? 'active' : '' %>" title="Rooms">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
      </a>
      <a href="/listings?category=Mountain<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Mountain' ? 'active' : '' %>" title="Mountain">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountain</p>
      </a>
      <a href="/listings?category=Castles<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>" title="Castles">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
      </a>
      <a href="/listings?category=Pools<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Pools' ? 'active' : '' %>" title="Pools">
        <i class="fa-solid fa-water-ladder"></i>
        <p>Pools</p>
      </a>
      <a href="/listings?category=Camping<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>" title="Camping">
        <i class="fa-solid fa-campground"></i>
        <p>Camping</p>
      </a>
      <a href="/listings?category=Snow<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Snow' ? 'active' : '' %>" title="Snow">
        <i class="fa-solid fa-snowflake"></i>
        <p>Snow</p>
      </a>
      <a href="/listings?category=Farms<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Farms' ? 'active' : '' %>" title="Farm">
        <i class="fa-solid fa-tractor"></i>
        <p>Farm</p>
      </a>
      <a href="/listings?category=City<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'City' ? 'active' : '' %>" title="City">
        <i class="fa-solid fa-city"></i>
        <p>City</p>
      </a>
      <a href="/listings?category=Beach<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Beach' ? 'active' : '' %>" title="Beach">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beach</p>
      </a>
      <a href="/listings?category=Cafe<%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="filter <%= activeCategory === 'Cafe' ? 'active' : '' %>" title="Café">
        <i class="fa-solid fa-mug-hot"></i>
        <p>Café</p>
      </a>

      <!-- Tax toggle -->
      <div class="tax-toggle ms-auto">
        <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
          <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch" style="cursor:pointer;">
          <label class="form-check-label" for="taxSwitch" style="cursor:pointer;">Show taxes</label>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Main Content -->
<div class="container mt-3">

  <!-- Search result header -->
  <% if (searchQuery && searchQuery.trim()) { %>
  <div class="search-result-header">
    <p class="result-text mb-0">
      <strong><%= allListings.length %></strong>
      result<%= allListings.length !== 1 ? 's' : '' %> for
      "<strong><%= searchQuery %></strong>"
    </p>
    <a href="/listings<%= activeCategory ? '?category=' + activeCategory : '' %>" class="btn-clear-search">
      <i class="fa-solid fa-xmark"></i> Clear search
    </a>
  </div>
  <% } %>

  <!-- Listings Grid -->
  <% if (allListings.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="fa-solid fa-compass"></i></div>
    <h4>No listings found</h4>
    <p>
      <% if (searchQuery) { %>
        We couldn't find anything for "<strong><%= searchQuery %></strong>".
        Try a different search term or <a href="/listings" style="color:var(--brand);font-weight:600;">browse all listings</a>.
      <% } else { %>
        There are no listings yet. <a href="/listings/new" style="color:var(--brand);font-weight:600;">Add one!</a>
      <% } %>
    </p>
  </div>
  <% } else { %>
  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-3 cards-section">
    <% for(let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="listing-card">
          <div class="card-img-wrap">
            <img
              src="<%= listing.image.url %>"
              alt="<%= listing.title %>"
              loading="lazy">
            <div class="card-img-overlay-custom"></div>
            <!-- wishlist heart -->
            <button class="card-wishlist" aria-label="Save to wishlist" onclick="event.preventDefault()">
              <i class="fa-regular fa-heart"></i>
            </button>
          </div>
          <div class="card-body">
            <div class="card-title"><%= listing.title %></div>
            <div class="card-location">
              <i class="fa-solid fa-location-dot"></i>
              <%= listing.location %>, <%= listing.country %>
            </div>
            <div class="card-price">
              <strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong>
              <span> / night</span>
              <span class="tax-info" style="display:none;color:var(--text-muted);font-size:0.75rem;"> &nbsp;+18% GST</span>
            </div>
          </div>
        </div>
      </a>
    </div>
    <% } %>
  </div>
  <% } %>

</div>

<script>
  // Tax toggle
  document.getElementById("taxSwitch").addEventListener("change", function () {
    document.querySelectorAll(".tax-info").forEach(function (el) {
      el.style.display = this.checked ? "inline" : "none";
    }, this);
  });

  // Wishlist heart toggle (purely visual)
  document.querySelectorAll(".card-wishlist").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      const icon = btn.querySelector("i");
      icon.classList.toggle("fa-regular");
      icon.classList.toggle("fa-solid");
      btn.style.color = icon.classList.contains("fa-solid") ? "var(--brand)" : "";
    });
  });
</script>
