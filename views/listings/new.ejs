<% layout("/layouts/boilerplate") %>

<div class="form-page">
  <h1>List Your Space</h1>
  <p class="form-subtitle">Fill in the details below to create a new listing on Stayora.</p>

  <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

    <div class="mb-3">
      <label class="form-label">Title</label>
      <input name="listing[title]" type="text" class="form-control" placeholder="e.g. Cozy Beachfront Cottage" required />
      <div class="invalid-feedback">Please add a title.</div>
    </div>

    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="listing[description]" class="form-control" rows="4" placeholder="Describe what makes your place special..." required></textarea>
      <div class="invalid-feedback">Please add a description.</div>
    </div>

    <div class="mb-3">
      <label class="form-label">Upload Image</label>
      <input name="image" type="file" class="form-control" accept="image/png, image/jpeg, image/jpg" />
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-5">
        <label class="form-label">Price <span style="color:var(--text-muted);font-weight:400;">(&#8377; / night)</span></label>
        <input name="listing[price]" type="number" class="form-control" placeholder="1200" required />
        <div class="invalid-feedback">Please enter a price.</div>
      </div>
      <div class="col-md-7">
        <label class="form-label">Country</label>
        <input name="listing[country]" type="text" class="form-control" placeholder="India" required />
        <div class="invalid-feedback">Please enter a country.</div>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Location</label>
      <input name="listing[location]" type="text" class="form-control" placeholder="Jaipur, Rajasthan" required />
      <div class="invalid-feedback">Please enter a location.</div>
    </div>

    <button type="submit" class="btn-form-submit">
      <i class="fa-solid fa-plus me-2"></i>Create Listing
    </button>
  </form>
</div>
