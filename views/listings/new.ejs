<% layout("/layouts/boilerplate") %>

<div class="form-page">

  <div class="form-page-header">
    <div class="form-page-icon">
      <i class="fa-solid fa-house-chimney-medical"></i>
    </div>
    <h1>List Your Space</h1>
    <p class="form-subtitle">Share your place with the world and start earning.</p>
  </div>

  <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">

    <div class="mb-3">
      <label class="form-label">Title</label>
      <input name="listing[title]" type="text" class="form-control" placeholder="e.g. Cozy Beachfront Cottage" required />
      <div class="invalid-feedback">Please add a title.</div>
    </div>

    <div class="mb-3">
      <label class="form-label">Description</label>
      <textarea name="listing[description]" class="form-control" rows="4"
        placeholder="Describe what makes your place special…" required></textarea>
      <div class="invalid-feedback">Please add a description.</div>
    </div>

    <div class="mb-3">
      <label class="form-label">
        <i class="fa-solid fa-image me-1" style="color:var(--brand);"></i>
        Upload Image <span style="color:var(--text-muted);font-weight:400;">(optional)</span>
      </label>
      <input name="image" type="file" class="form-control" accept="image/png, image/jpeg, image/jpg, image/webp" />
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-5">
        <label class="form-label">Price per Night (&#8377;)</label>
        <input name="listing[price]" type="number" class="form-control" placeholder="1200" min="0" required />
        <div class="invalid-feedback">Please enter a price.</div>
      </div>
      <div class="col-md-7">
        <label class="form-label">Country</label>
        <input name="listing[country]" type="text" class="form-control" placeholder="India" required />
        <div class="invalid-feedback">Please enter a country.</div>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Location</label>
      <input name="listing[location]" type="text" class="form-control" placeholder="Jaipur, Rajasthan" required />
      <div class="invalid-feedback">Please enter a location.</div>
    </div>

    <button type="submit" class="btn-form-submit">
      <i class="fa-solid fa-plus"></i> Create Listing
    </button>
  </form>
</div>
