<% layout("/layouts/boilerplate") %>

<div class="show-page mt-3">

  <!-- Back link -->
  <a href="/listings" class="back-link">
    <i class="fa-solid fa-arrow-left"></i> Back to listings
  </a>

  <!-- Hero image -->
  <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="show-img">

  <!-- Title -->
  <h1 class="show-title"><%= listing.title %></h1>

  <!-- Location -->
  <p class="show-location">
    <i class="fa-solid fa-location-dot"></i>
    <%= listing.location %>, <%= listing.country %>
  </p>

  <!-- Meta badges -->
  <div class="show-meta-badges">
    <span class="show-meta-badge">
      <i class="fa-solid fa-map-pin"></i> <%= listing.location %>
    </span>
    <span class="show-meta-badge">
      <i class="fa-solid fa-flag"></i> <%= listing.country %>
    </span>
    <% if(listing.reviews && listing.reviews.length > 0) { %>
    <span class="show-meta-badge">
      <i class="fa-solid fa-star" style="color:var(--accent);"></i>
      <%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %>
    </span>
    <% } %>
  </div>

  <!-- Owner badge -->
  <div class="show-owner-badge">
    <i class="fa-solid fa-circle-user"></i>
    Hosted by <strong><%= listing.owner.username %></strong>
  </div>

  <hr class="divider">

  <!-- Description -->
  <p class="show-description"><%= listing.description %></p>

  <!-- Price card -->
  <div class="show-price-card">
    <div class="price-icon">
      <i class="fa-solid fa-indian-rupee-sign"></i>
    </div>
    <div class="price-details">
      <span class="price-amount">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
      <span class="price-label">per night · taxes may apply</span>
    </div>
  </div>

  <!-- Edit / Delete (owner only) -->
  <% if(curUser && curUser._id.equals(listing.owner._id)) { %>
  <div class="show-actions">
    <a href="/listings/<%= listing._id %>/edit" class="btn-edit">
      <i class="fa-solid fa-pen"></i> Edit Listing
    </a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="margin:0;">
      <button type="submit" class="btn-delete">
        <i class="fa-solid fa-trash"></i> Delete
      </button>
    </form>
  </div>
  <% } %>

  <hr class="divider">

  <!-- Reviews Section -->
  <div class="review-section">

    <!-- Leave a Review form -->
    <% if(curUser) { %>
    <div class="review-form-card">
      <h4 class="review-form-title">
        <i class="fa-solid fa-star" style="color:var(--accent);"></i> Leave a Review
      </h4>

      <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation" novalidate>

        <!-- Star rating -->
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:0.82rem;color:var(--text-secondary);">Rating</label>
          <div class="star-rating-widget">
            <div class="stars-row" id="starsRow">
              <span class="star" data-value="1">&#9733;</span>
              <span class="star" data-value="2">&#9733;</span>
              <span class="star" data-value="3">&#9733;</span>
              <span class="star" data-value="4">&#9733;</span>
              <span class="star" data-value="5">&#9733;</span>
            </div>
            <span class="rating-label" id="ratingLabel">Select a rating</span>
            <input type="hidden" name="review[rating]" id="ratingInput" value="" required />
          </div>
        </div>

        <!-- Comment -->
        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold" style="font-size:0.82rem;color:var(--text-secondary);">Comment</label>
          <textarea
            name="review[comment]"
            required
            id="comment"
            rows="4"
            class="review-textarea"
            placeholder="Share your experience…"></textarea>
          <div class="invalid-feedback">Please add a comment.</div>
        </div>

        <button type="submit" class="btn-submit-review">
          <i class="fa-solid fa-paper-plane"></i> Submit Review
        </button>
      </form>
    </div>
    <% } else { %>
    <div class="review-form-card" style="text-align:center;padding:1.5rem;">
      <i class="fa-solid fa-lock" style="font-size:1.75rem;color:var(--text-muted);margin-bottom:0.75rem;display:block;"></i>
      <p style="color:var(--text-secondary);font-size:0.9rem;margin:0;">
        <a href="/login" style="color:var(--brand);font-weight:700;">Log in</a> to leave a review.
      </p>
    </div>
    <% } %>

    <!-- All reviews -->
    <% if(listing.reviews.length > 0) { %>
    <h4 class="review-section-title mt-4">
      <i class="fa-solid fa-comments" style="color:var(--brand);"></i>
      Guest Reviews
      <span class="review-count-badge"><%= listing.reviews.length %></span>
    </h4>
    <div class="row g-3">
      <% for(let review of listing.reviews) { %>
      <div class="col-md-6">
        <div class="review-card">
          <div class="reviewer-row">
            <div class="reviewer-avatar"><%= review.author.username.charAt(0) %></div>
            <span class="reviewer">@<%= review.author.username %></span>
          </div>
          <!-- star display -->
          <p class="starability-result review-comment" data-rating="<%= review.rating %>"></p>
          <p class="review-comment"><%= review.comment %></p>
          <% if(curUser && review.author && curUser._id.equals(review.author._id)) { %>
          <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" style="margin-top:0.5rem;">
            <button type="submit" class="btn-delete" style="padding:0.3rem 0.9rem;font-size:0.75rem;">
              <i class="fa-solid fa-trash"></i> Delete
            </button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>

  </div>
</div>

<script>
  (function () {
    const labels = ["Terrible", "Not good", "Average", "Very good", "Amazing!"];
    const stars = document.querySelectorAll("#starsRow .star");
    const input = document.getElementById("ratingInput");
    const lbl   = document.getElementById("ratingLabel");
    let selected = 0;

    function paint(upTo, cls) {
      stars.forEach(function (s, i) { s.classList.toggle(cls, i < upTo); });
    }

    stars.forEach(function (star) {
      star.addEventListener("mouseenter", function () {
        const v = +star.dataset.value;
        paint(v, "hovered");
        lbl.textContent = labels[v - 1];
      });
      star.addEventListener("mouseleave", function () {
        paint(0, "hovered");
        lbl.textContent = selected ? labels[selected - 1] : "Select a rating";
      });
      star.addEventListener("click", function () {
        selected = +star.dataset.value;
        input.value = selected;
        paint(selected, "selected");
        lbl.textContent = labels[selected - 1];
      });
    });
  })();
</script>
