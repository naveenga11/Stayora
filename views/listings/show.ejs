<% layout("/layouts/boilerplate") %>

<div class="show-page mt-3">

  <!-- Image -->
  <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="show-img">

  <!-- Title & meta -->
  <h1 class="show-title"><%= listing.title %></h1>
  <p class="show-location">
    <i class="fa-solid fa-location-dot me-1" style="color:var(--brand);"></i>
    <%= listing.location %>, <%= listing.country %>
  </p>

  <div class="show-owner-badge">
    <i class="fa-solid fa-circle-user"></i>
    Hosted by <strong class="ms-1"><%= listing.owner.username %></strong>
  </div>

  <hr class="divider">

  <!-- Description -->
  <p class="show-description"><%= listing.description %></p>

  <!-- Price -->
  <div class="show-price-card">
    <span class="price-amount">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
    <span class="price-label">/ night</span>
  </div>

  <!-- Edit / Delete (owner only) -->
  <% if(curUser && curUser._id.equals(listing.owner._id)) { %>
  <div class="show-actions">
    <a href="/listings/<%= listing._id %>/edit" class="btn-edit">
      <i class="fa-solid fa-pen me-1"></i>Edit
    </a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="margin:0;">
      <button type="submit" class="btn-delete">
        <i class="fa-solid fa-trash me-1"></i>Delete
      </button>
    </form>
  </div>
  <% } %>

  <hr class="divider">

  <!-- Leave a review -->
  <div class="review-section">
    <% if(curUser) { %>
    <h4>Leave a Review</h4>

    <form action="/listings/<%= listing.id %>/reviews" method="post" class="needs-validation mb-4" novalidate>

      <!-- Star rating -->
      <div class="mb-3">
        <label class="form-label fw-semibold">Your Rating</label>
        <div class="star-rating-widget">
          <div class="stars-row" id="starsRow">
            <span class="star" data-value="1">&#9733;</span>
            <span class="star" data-value="2">&#9733;</span>
            <span class="star" data-value="3">&#9733;</span>
            <span class="star" data-value="4">&#9733;</span>
            <span class="star" data-value="5">&#9733;</span>
          </div>
          <span class="rating-label" id="ratingLabel">Select a rating</span>
          <input type="hidden" name="review[rating]" id="ratingInput" value="" required />
        </div>
      </div>

      <!-- Comment -->
      <div class="mb-3">
        <label for="comment" class="form-label fw-semibold">Comment</label>
        <textarea name="review[comment]" required id="comment" rows="4" class="form-control" placeholder="Share your experience..."></textarea>
        <div class="invalid-feedback">Please add a comment.</div>
      </div>

      <button type="submit" class="btn btn-dark px-4" style="border-radius:2rem;">Submit Review</button>
    </form>
    <% } else { %>
    <p class="text-muted" style="font-size:0.9rem;">
      <a href="/login" style="color:var(--brand);font-weight:600;">Log in</a> to leave a review.
    </p>
    <% } %>

    <!-- All reviews -->
    <% if(listing.reviews.length > 0) { %>
    <h4 class="mt-4">Guest Reviews <span style="color:var(--text-muted);font-weight:400;font-size:0.9rem;">(<%= listing.reviews.length %>)</span></h4>
    <div class="row g-3 mt-1">
      <% for(let review of listing.reviews) { %>
      <div class="col-md-6">
        <div class="review-card">
          <div class="reviewer">@<%= review.author.username %></div>
          <p class="starability-result review-comment" data-rating="<%= review.rating %>"></p>
          <p class="review-comment"><%= review.comment %></p>
          <% if(curUser && review.author && curUser._id.equals(review.author._id)) { %>
          <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
            <button class="btn btn-sm btn-outline-danger" style="border-radius:2rem;font-size:0.75rem;">
              <i class="fa-solid fa-trash me-1"></i>Delete
            </button>
          </form>
          <% } %>
        </div>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

</div>

<style>
  .star-rating-widget { display: flex; align-items: center; gap: 0.75rem; }
  .stars-row { display: flex; gap: 4px; }
  .star {
    font-size: 2rem;
    color: #d1d5db;
    cursor: pointer;
    transition: color 0.15s, transform 0.15s;
    user-select: none;
  }
  .star.hovered, .star.selected { color: #f59e0b; }
  .star:hover { transform: scale(1.2); }
  .rating-label { font-size: 0.85rem; color: #6b7280; font-style: italic; min-width: 90px; }
</style>

<script>
  (function () {
    const labels = ["Terrible", "Not good", "Average", "Very good", "Amazing"];
    const stars = document.querySelectorAll("#starsRow .star");
    const input = document.getElementById("ratingInput");
    const lbl = document.getElementById("ratingLabel");
    let selected = 0;

    function paint(upTo, cls) {
      stars.forEach(function (s, i) { s.classList.toggle(cls, i < upTo); });
    }

    stars.forEach(function (star) {
      star.addEventListener("mouseenter", function () {
        const v = +star.dataset.value;
        paint(v, "hovered");
        lbl.textContent = labels[v - 1];
      });
      star.addEventListener("mouseleave", function () {
        paint(0, "hovered");
        lbl.textContent = selected ? labels[selected - 1] : "Select a rating";
      });
      star.addEventListener("click", function () {
        selected = +star.dataset.value;
        input.value = selected;
        paint(selected, "selected");
        lbl.textContent = labels[selected - 1];
      });
    });
  })();
</script>
